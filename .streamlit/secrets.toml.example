# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud ‚Üí App settings ‚Üí Secrets.
# Leave ANTHROPIC_API_KEY empty to make visitors bring their own key.
ANTHROPIC_API_KEY = ""
# Access code visitors must enter to use your key (share it only with recruiters).
# Without it, anyone can use your key.
APP_PASSWORD = ""

# Optional: anonymous usage analytics (see docs/ANALYTICS.md). Use "debug" to print events locally.
POSTHOG_KEY = ""
POSTHOG_HOST = "https://eu.i.posthog.com"
